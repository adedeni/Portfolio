{
  "id": "template-5",
  "name": "Bento",
  "description": "A modern bento grid: wallet, quick buy, plans and bills, each in its own tile.",
  "cssVars": [
    {
      "label": "Accent colour",
      "variable": "--accent-color",
      "default": "#2f6bff"
    },
    {
      "label": "Background",
      "variable": "--bg-color",
      "default": "#f2f1ec"
    },
    {
      "label": "Dark tile",
      "variable": "--ink-color",
      "default": "#141414"
    }
  ],
  "editables": [
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "section": "Style",
      "variable": "--font-family",
      "selectors": [],
      "default": "modern"
    },
    {
      "id": "brand_logo",
      "label": "Logo",
      "type": "image",
      "section": "Header",
      "selectors": [
        "#brand-logo",
        "#brand-logo-footer"
      ],
      "default": ""
    },
    {
      "id": "brand_name",
      "label": "Business name",
      "type": "text",
      "section": "Header",
      "selectors": [
        ".brand-name"
      ],
      "default": "Tapcharge"
    },
    {
      "id": "hero_title",
      "label": "Headline",
      "type": "textarea",
      "section": "Hero",
      "selectors": [
        "#hero-title"
      ],
      "default": "Every top-up you need, one tap away."
    },
    {
      "id": "hero_subtitle",
      "label": "Subheadline",
      "type": "textarea",
      "section": "Hero",
      "selectors": [
        "#hero-subtitle"
      ],
      "default": "Airtime, data, electricity and cable TV for every network, paid from a single wallet."
    },
    {
      "id": "hero_cta",
      "label": "Button text",
      "type": "text",
      "section": "Hero",
      "selectors": [
        "#hero-cta"
      ],
      "default": "Start topping up"
    },
    {
      "id": "plans",
      "label": "Plans",
      "type": "list",
      "section": "Plans",
      "selectors": [
        "#plan-list"
      ],
      "default": [
        {
          "size": "1.5GB",
          "price": "₦1,000"
        },
        {
          "size": "4GB",
          "price": "₦2,200",
          "featured": true
        },
        {
          "size": "10GB",
          "price": "₦4,500"
        }
      ]
    },
    {
      "id": "show_tv",
      "label": "Show cable TV tile",
      "type": "toggle",
      "section": "Tiles",
      "selectors": [
        "#tv-tile"
      ],
      "default": "on"
    },
    {
      "id": "support_text",
      "label": "Support message",
      "type": "textarea",
      "section": "Support",
      "selectors": [
        "#support-text"
      ],
      "default": "Stuck on an order? Our team answers within minutes, day and night."
    },
    {
      "id": "show_support",
      "label": "Show support tile",
      "type": "toggle",
      "section": "Support",
      "selectors": [
        "#support-tile"
      ],
      "default": "on"
    },
    {
      "id": "how_title",
      "label": "Section title",
      "type": "text",
      "section": "How it works",
      "selectors": [
        "#how-title"
      ],
      "default": "Top up in 3 simple steps"
    },
    {
      "id": "show_how",
      "label": "Show this section",
      "type": "toggle",
      "section": "How it works",
      "selectors": [
        "#how-section"
      ],
      "default": "on"
    },
    {
      "id": "why_title",
      "label": "Section title",
      "type": "text",
      "section": "Why us",
      "selectors": [
        "#why-title"
      ],
      "default": "Why customers choose us"
    },
    {
      "id": "show_why",
      "label": "Show this section",
      "type": "toggle",
      "section": "Why us",
      "selectors": [
        "#why-section"
      ],
      "default": "on"
    },
    {
      "id": "reseller_title",
      "label": "Section title",
      "type": "text",
      "section": "Resellers",
      "selectors": [
        "#reseller-title"
      ],
      "default": "Start your own top-up business"
    },
    {
      "id": "show_reseller",
      "label": "Show this section",
      "type": "toggle",
      "section": "Resellers",
      "selectors": [
        "#reseller-section"
      ],
      "default": "on"
    },
    {
      "id": "faq_title",
      "label": "Section title",
      "type": "text",
      "section": "FAQ",
      "selectors": [
        "#faq-title"
      ],
      "default": "Questions, answered"
    },
    {
      "id": "show_faq",
      "label": "Show this section",
      "type": "toggle",
      "section": "FAQ",
      "selectors": [
        "#faq-section"
      ],
      "default": "on"
    },
    {
      "id": "cta_title",
      "label": "Headline",
      "type": "text",
      "section": "Call to action",
      "selectors": [
        "#cta-title"
      ],
      "default": "Ready to top up?"
    },
    {
      "id": "show_cta",
      "label": "Show this section",
      "type": "toggle",
      "section": "Call to action",
      "selectors": [
        "#cta-section"
      ],
      "default": "on"
    },
    {
      "id": "footer_about",
      "label": "About text",
      "type": "textarea",
      "section": "Footer",
      "selectors": [
        "#footer-about"
      ],
      "default": "Airtime, data, electricity and cable TV, delivered automatically from one wallet."
    },
    {
      "id": "support_email",
      "label": "Support email",
      "type": "text",
      "section": "Footer",
      "selectors": [
        "#support-email"
      ],
      "default": "support@tapcharge.example"
    }
  ]
}
