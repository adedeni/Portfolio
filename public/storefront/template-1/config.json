{
  "id": "template-1",
  "name": "Pulse",
  "description": "Bold and colourful, with an app preview and a data plan price list.",
  "cssVars": [
    {
      "label": "Primary colour",
      "variable": "--primary-color",
      "default": "#e8590c"
    },
    {
      "label": "Secondary colour",
      "variable": "--secondary-color",
      "default": "#c2255c"
    },
    {
      "label": "Page tint",
      "variable": "--tint-color",
      "default": "#fff4ec"
    }
  ],
  "editables": [
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "section": "Style",
      "variable": "--font-family",
      "selectors": [],
      "default": "modern"
    },
    {
      "id": "brand_logo",
      "label": "Logo",
      "type": "image",
      "section": "Header",
      "selectors": [
        "#brand-logo"
      ],
      "default": ""
    },
    {
      "id": "brand_name",
      "label": "Business name",
      "type": "text",
      "section": "Header",
      "selectors": [
        ".brand-name"
      ],
      "default": "Ember Topup"
    },
    {
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "section": "Hero",
      "selectors": [
        "#hero-eyebrow"
      ],
      "default": "Instant top-up, any time"
    },
    {
      "id": "hero_title",
      "label": "Headline",
      "type": "textarea",
      "section": "Hero",
      "selectors": [
        "#hero-title"
      ],
      "default": "Data and airtime that land before you blink."
    },
    {
      "id": "hero_subtitle",
      "label": "Subheadline",
      "type": "textarea",
      "section": "Hero",
      "selectors": [
        "#hero-subtitle"
      ],
      "default": "Top up MTN, Airtel and 9mobile, pay for electricity and renew cable TV from one wallet."
    },
    {
      "id": "hero_cta",
      "label": "Button text",
      "type": "text",
      "section": "Hero",
      "selectors": [
        "#hero-cta"
      ],
      "default": "Buy data"
    },
    {
      "id": "plans_title",
      "label": "Section title",
      "type": "text",
      "section": "Plans",
      "selectors": [
        "#plans-title"
      ],
      "default": "Popular data plans"
    },
    {
      "id": "plans",
      "label": "Plans",
      "type": "list",
      "section": "Plans",
      "selectors": [
        "#plan-list"
      ],
      "default": [
        {
          "size": "1.5GB",
          "price": "₦1,000"
        },
        {
          "size": "4GB",
          "price": "₦2,200",
          "featured": true
        },
        {
          "size": "10GB",
          "price": "₦4,500"
        }
      ]
    },
    {
      "id": "show_plans",
      "label": "Show plans",
      "type": "toggle",
      "section": "Plans",
      "selectors": [
        "#plans-section"
      ],
      "default": "on"
    },
    {
      "id": "show_perks",
      "label": "Show perks",
      "type": "toggle",
      "section": "Perks",
      "selectors": [
        "#perks-section"
      ],
      "default": "on"
    }
  ]
}
