{
  "id": "template-3",
  "name": "Orbit",
  "description": "Playful and chunky: service icons orbit a live wallet, with sticker labels and hard-shadow cards.",
  "cssVars": [
    {
      "label": "Primary colour",
      "variable": "--primary-color",
      "default": "#4b3bff"
    },
    {
      "label": "Pop colour",
      "variable": "--secondary-color",
      "default": "#c6f24e"
    },
    {
      "label": "Page tint",
      "variable": "--tint-color",
      "default": "#f4f2ff"
    }
  ],
  "editables": [
    {
      "id": "font",
      "label": "Font",
      "type": "font",
      "section": "Style",
      "variable": "--font-family",
      "selectors": [],
      "default": "brand"
    },
    {
      "id": "brand_logo",
      "label": "Logo",
      "type": "image",
      "section": "Header",
      "selectors": [
        "#brand-logo",
        "#brand-logo-footer"
      ],
      "default": ""
    },
    {
      "id": "brand_name",
      "label": "Business name",
      "type": "text",
      "section": "Header",
      "selectors": [
        ".brand-name"
      ],
      "default": "Zuma"
    },
    {
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "type": "text",
      "section": "Hero",
      "selectors": [
        "#hero-eyebrow"
      ],
      "default": "Delivered in seconds"
    },
    {
      "id": "hero_title",
      "label": "Headline",
      "type": "textarea",
      "section": "Hero",
      "selectors": [
        "#hero-title"
      ],
      "default": "Top up everything"
    },
    {
      "id": "hero_accent",
      "label": "Headline (highlighted part)",
      "type": "text",
      "section": "Hero",
      "selectors": [
        "#hero-accent"
      ],
      "default": "in your orbit."
    },
    {
      "id": "hero_subtitle",
      "label": "Subheadline",
      "type": "textarea",
      "section": "Hero",
      "selectors": [
        "#hero-subtitle"
      ],
      "default": "Airtime, data, electricity and TV for every network, all circling one simple wallet."
    },
    {
      "id": "hero_cta",
      "label": "Button text",
      "type": "text",
      "section": "Hero",
      "selectors": [
        "#hero-cta"
      ],
      "default": "Start topping up"
    },
    {
      "id": "services_title",
      "label": "Section title",
      "type": "text",
      "section": "Services",
      "selectors": [
        "#services-title"
      ],
      "default": "Everything you need to stay connected"
    },
    {
      "id": "show_services",
      "label": "Show this section",
      "type": "toggle",
      "section": "Services",
      "selectors": [
        "#services-section"
      ],
      "default": "on"
    },
    {
      "id": "how_title",
      "label": "Section title",
      "type": "text",
      "section": "How it works",
      "selectors": [
        "#how-title"
      ],
      "default": "Top up in 3 simple steps"
    },
    {
      "id": "show_how",
      "label": "Show this section",
      "type": "toggle",
      "section": "How it works",
      "selectors": [
        "#how-section"
      ],
      "default": "on"
    },
    {
      "id": "pricing_title",
      "label": "Section title",
      "type": "text",
      "section": "Pricing",
      "selectors": [
        "#pricing-title"
      ],
      "default": "Data plans for every budget"
    },
    {
      "id": "show_pricing",
      "label": "Show this section",
      "type": "toggle",
      "section": "Pricing",
      "selectors": [
        "#pricing-section"
      ],
      "default": "on"
    },
    {
      "id": "plans",
      "label": "Plans",
      "type": "list",
      "section": "Pricing",
      "selectors": [
        "#plan-list"
      ],
      "default": [
        {
          "size": "1.5GB",
          "price": "₦1,000"
        },
        {
          "size": "4GB",
          "price": "₦2,200",
          "featured": true
        },
        {
          "size": "10GB",
          "price": "₦4,500"
        },
        {
          "size": "25GB",
          "price": "₦9,000"
        }
      ]
    },
    {
      "id": "why_title",
      "label": "Section title",
      "type": "text",
      "section": "Why us",
      "selectors": [
        "#why-title"
      ],
      "default": "Why customers choose us"
    },
    {
      "id": "show_why",
      "label": "Show this section",
      "type": "toggle",
      "section": "Why us",
      "selectors": [
        "#why-section"
      ],
      "default": "on"
    },
    {
      "id": "reseller_title",
      "label": "Section title",
      "type": "text",
      "section": "Resellers",
      "selectors": [
        "#reseller-title"
      ],
      "default": "Start your own top-up business"
    },
    {
      "id": "show_reseller",
      "label": "Show this section",
      "type": "toggle",
      "section": "Resellers",
      "selectors": [
        "#reseller-section"
      ],
      "default": "on"
    },
    {
      "id": "faq_title",
      "label": "Section title",
      "type": "text",
      "section": "FAQ",
      "selectors": [
        "#faq-title"
      ],
      "default": "Questions, answered"
    },
    {
      "id": "show_faq",
      "label": "Show this section",
      "type": "toggle",
      "section": "FAQ",
      "selectors": [
        "#faq-section"
      ],
      "default": "on"
    },
    {
      "id": "cta_title",
      "label": "Headline",
      "type": "text",
      "section": "Call to action",
      "selectors": [
        "#cta-title"
      ],
      "default": "Ready to top up?"
    },
    {
      "id": "show_cta",
      "label": "Show this section",
      "type": "toggle",
      "section": "Call to action",
      "selectors": [
        "#cta-section"
      ],
      "default": "on"
    },
    {
      "id": "footer_about",
      "label": "About text",
      "type": "textarea",
      "section": "Footer",
      "selectors": [
        "#footer-about"
      ],
      "default": "Airtime, data, electricity and cable TV, delivered automatically from one wallet."
    },
    {
      "id": "support_email",
      "label": "Support email",
      "type": "text",
      "section": "Footer",
      "selectors": [
        "#support-email"
      ],
      "default": "support@zuma.example"
    }
  ]
}
